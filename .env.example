# 站点域名（换域名只改这一处）
NEXT_PUBLIC_SITE_URL=https://prismlens.app

# AI 分析接口（OpenAI 兼容协议，任选一家填入即可）
# 智谱开放平台示例：https://open.bigmodel.cn/api/paas/v4 / glm-4.6
# DeepSeek 示例：https://api.deepseek.com/v1 / deepseek-chat
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZAI_API_KEY=
ZAI_MODEL=glm-4.6

# 数据库（订阅与资讯存储，可选；未配置时相关接口降级）
DATABASE_URL=file:/tmp/prismlens.db
