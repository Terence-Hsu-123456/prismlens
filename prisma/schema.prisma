generator client {
  provider      = "prisma-client-js"
  // 本地 = native；Vercel（Amazon Linux 2023 / OpenSSL 3）需要额外引擎包
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 订阅/订单记录：打开支付弹窗即生成 PENDING 订单（订单号凭证），
// 用户扫码付款并确认后置为 ACTIVE。个人收款码无回调，订单留档便于人工对账。
model Subscription {
  id          String    @id @default(cuid())
  orderNo     String    @unique // 订单号（PL+日期+随机），付款凭证
  plan        String    @default("pro") // 目前仅 pro
  channel     String // wechat | alipay
  months      Int // 1 | 12
  amountCNY   Float // 应付金额（人民币）
  payerNote   String    @default("") // 付款人姓名/备注（用户自填，建议含订单尾号）
  status      String    @default("PENDING") // PENDING | ACTIVE
  deviceId    String    @default("") // 激活设备标识
  createdAt   DateTime  @default(now())
  activatedAt DateTime?
  expiresAt   DateTime?
}

// 聚合资讯：多源 RSS 入库去重，随时间动态增多
model NewsArticle {
  id          String   @id @default(cuid())
  guid        String   @unique // RSS guid / link 哈希，去重键
  title       String
  url         String
  publisher   String // 媒体名（Google News source 标签 / feed 名）
  source      String // feed 标识：google-zh / yahoo / cnbc / marketwatch ...
  lang        String // zh | en | ja
  symbol      String? // 关联股票代码（公司新闻，可空）
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([symbol, publishedAt])
  @@index([lang, publishedAt])
}

// 宏观周期快照（按季度）
model MacroSnapshot {
  id        String @id @default(cuid())
  period    String @unique // 例如 "2023Q1"
  gdpGrowth Float  // GDP 同比 %
  cpi       Float  // CPI 同比 %
  pmi       Float  // 制造业 PMI
  yield10Y  Float  // 10 年期国债收益率 %
  m2Growth  Float  // M2 同比 %
  phase     String // recovery | overheating | stagflation | recession
}

// 行业
model Industry {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  lifecycle   String // 引入期 | 成长期 | 成熟期 | 衰退期
  cyclicality String // 强周期 | 弱周期 | 逆周期
  summary     String
  pest        String // JSON: {political, economic, social, technological}
  porter      String // JSON: {rivalry, suppliers, buyers, entrants, substitutes} 0-100
  chain       String // JSON: {upstream[], midstream[], downstream[]}
  leaders     String // JSON: string[]
  avgPe       Float
  growthYoY   Float
  prosperity  Float // 景气指数 0-100
  companies   Company[]
}

// 选股器公司池：全球市场动态同步（新浪A股 / HKEX官方名单 / Nasdaq官方筛选器 / 腾讯行情 / 人工精选）
// 新股上市后随每日名单自动入库，退市后自动清理 —— 动态化
model ScreenCompany {
  symbol        String   @id // 统一 Yahoo 风格代码：600519.SS / 0700.HK / AAPL
  market        String // US | CN | HK | JP | KR | IN | EU
  nameZh        String
  nameEn        String   @default("")
  nameJa        String   @default("")
  country       String   @default("")
  sector        String? // tech/consumer/finance/health/energy/industrial/materials/utility/comm/realestate；未知为 null
  stage         String   @default("growth") // startup | growth | mature | turnaround
  tags          String   @default("[]") // JSON string[]（定性搜索用，含行业名等）
  price         Float? // 现价（本币）；暂无行情为 null
  currency      String   @default("USD")
  changePercent Float?
  marketCap     Float? // 市值（本币）
  capUsd        Float? // 市值（USD 折算），用于统一排序/筛选
  pe            Float?
  pb            Float?
  dividendYield Float? // %
  roe           Float? // %
  profitMargin  Float? // %
  revenueGrowth Float? // %
  source        String   @default("bulk") // bulk（全量源）| curated（人工精选，永不清理）
  seenAt        DateTime @default(now()) // 最近一次同步见到（退市清理依据）
  updatedAt     DateTime @updatedAt

  @@index([market, capUsd])
  @@index([sector])
  @@index([stage])
}

// 同步状态（各市场/名单最后同步时间与信息）
model SyncState {
  key  String   @id
  at   DateTime
  info String   @default("")
}

// 一级市场融资轮次（天使轮/VC/PE，公开报道整理，随市场动态补充）
model FundingRound {
  id            String   @id @default(cuid())
  company       String // 公司名（中文）
  companyEn     String   @default("")
  market        String // CN | US | EU | JP | IN | OTHER
  sector        String // 行业 key（同 ScreenCompany）
  stage         String // angel | seed | a | b | c | pe | preipo
  roundLabel    String // 天使轮 / A轮 / B轮 / C轮 / PE轮 / Pre-IPO（展示用）
  date          String // 披露时间 YYYY-MM
  amountUsd     Float? // 披露金额（美元）；未披露为 null
  valuationUsd  Float? // 投后估值（美元，约）；未披露为 null
  leadInvestors String   @default("") // 领投方
  desc          String   @default("") // 一句话简介
  tags          String   @default("[]") // JSON string[]
  createdAt     DateTime @default(now())

  @@index([stage, date])
  @@index([market])
}

// 企业（覆盖一级市场天使/VC/PE 与二级市场上市公司）
model Company {
  id            String    @id @default(cuid())
  ticker        String    @unique
  name          String
  industryId    String
  industry      Industry  @relation(fields: [industryId], references: [id])
  stage         String // 初创期 | 成长期 | 成熟期 | 衰退期
  round         String // 天使轮 | A轮 | B轮 | PE轮(Pre-IPO) | 已上市
  listed        Boolean
  marketCapE8   Float // 市值/估值（亿元）
  price         Float // 股价（元），未上市为 0
  chg1Y         Float // 近一年涨跌幅 %
  pe            Float? // 市盈率，亏损为 null
  pb            Float
  psTtm         Float?
  roe           Float
  grossMargin   Float
  netMargin     Float
  debtRatio     Float
  revenueGrowth Float
  profitGrowth  Float
  dividendYield Float?
  moatType      String
  moatScore     Float // 0-10
  moatDesc      String
  finHistory    String // JSON: [{year, revenueE8, profitE8}]
  priceState    String // JSON: {trend, phase, volume, support, resistance, maSignal}
  quantFactors  String // JSON: {momentum, value, quality, growth} 0-100
  signals       String // JSON: {dow:{label,score,reason}, value:{...}, fundamental:{...}, quant:{...}}
  overall       String // 强烈看多 | 看多 | 中性 | 看空 | 强烈看空
  overallScore  Float // 0-100
  confidence    Float // 0-100
  desc          String
  tags          String // JSON: string[]
  foundedYear   Int
}
